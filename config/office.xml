<Configuration>
  <!-- Forza l’installazione a 64 bit e imposta il canale di aggiornamento, ad es. 'Current' -->
  <Add OfficeClientEdition="64" Channel="Current">
	<!-- Product ID tipico per Microsoft 365 Apps for Enterprise/Business -->
	<Product ID="O365ProPlusRetail">
	  <!-- Lingua italiana -->
	  <Language ID="it-it" />
	  <!-- Esempio: se vuoi escludere Access, Publisher, Teams, aggiungi:
		   <ExcludeApp ID="Access" />
		   <ExcludeApp ID="Publisher" />
		   <ExcludeApp ID="Teams" /> 
	  -->
	</Product>
  </Add>

  <!-- Rimuove eventuali versioni Office (MSI) preesistenti.
       Nessun attributo: RemoveMSI rimuove per default tutti i prodotti MSI.
       L’attributo All non è nello schema ODT corrente -->
  <RemoveMSI />

  <!-- Installazione completamente silenziosa e accetta la licenza -->
  <Display Level="None" AcceptEULA="TRUE" />

  <!-- AUTOACTIVATE rimosso: Microsoft 365 Apps si attiva gia automaticamente e la
       documentazione ODT sconsiglia di impostare la proprieta per questi prodotti -->
</Configuration>
